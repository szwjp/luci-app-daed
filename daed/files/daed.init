#!/bin/sh /etc/rc.common
# Copyright (C) 2023 Tianling Shen <cnsztl@immortalwrt.org>

USE_PROCD=1
START=99

CONF="daed"
PROG="/usr/bin/daed"
LOG="/var/log/daed/daed.log"
RESOLV_DAED="/tmp/resolv.conf.daed"

# /tmp/resolv.conf 默认已由 netifd 写入 WAN 上游 DNS，劫持属于可选的兜底手段，
# 因此由 UCI 选项 hijack_resolv（默认关）控制，避免无条件遮蔽 netifd/dnsmasq 的更新。
is_resolv_hijacked() {
	grep -q ' /tmp/resolv\.conf ' /proc/mounts
}

hijack_resolv_conf() {
	local dns_list logical_wan

	is_resolv_hijacked && return 0
	[ -e /tmp/resolv.conf ] || return 1

	grep -E '^(search|domain) ' /tmp/resolv.conf > "$RESOLV_DAED" 2>/dev/null

	. /lib/functions/network.sh
	network_find_wan logical_wan 2>/dev/null
	if [ -n "$logical_wan" ]; then
		dns_list=$(ubus call "network.interface.$logical_wan" status 2>/dev/null | \
			jsonfilter -e '@["dns-server"][*]' 2>/dev/null)
	fi
	if [ -z "$dns_list" ] && [ -f /tmp/resolv.conf.d/resolv.conf.auto ]; then
		dns_list=$(awk '/^nameserver/{print $2}' /tmp/resolv.conf.d/resolv.conf.auto 2>/dev/null)
	fi

	# 拿不到任何上游 DNS 就放弃劫持，不要用硬编码地址污染用户环境。
	if [ -z "$dns_list" ]; then
		rm -f "$RESOLV_DAED"
		return 1
	fi

	local dns
	for dns in $dns_list; do
		echo "nameserver $dns" >> "$RESOLV_DAED"
	done

	mount --bind "$RESOLV_DAED" /tmp/resolv.conf
	mount -o remount,ro,bind /tmp/resolv.conf
}

restore_resolv_conf() {
	is_resolv_hijacked || return 0
	mount -o remount,rw,bind /tmp/resolv.conf 2>/dev/null
	umount /tmp/resolv.conf 2>/dev/null
	rm -f "$RESOLV_DAED"
}

start_service() {
	local enabled listen_addr log_maxbackups log_maxsize hijack_resolv

	config_load "$CONF"
	config_get_bool enabled "config" "enabled" 0
	[ "$enabled" -eq 1 ] || return 0

	config_get listen_addr "config" "listen_addr" "0.0.0.0:2023"
	config_get log_maxbackups "config" "log_maxbackups" "1"
	config_get log_maxsize "config" "log_maxsize" "5"
	config_get_bool hijack_resolv "config" "hijack_resolv" 0

	[ "$hijack_resolv" -eq 1 ] && hijack_resolv_conf

	procd_open_instance "$CONF"
	procd_set_param command "$PROG" run
	procd_append_param command --config /etc/daed/
	procd_append_param command --listen "$listen_addr"
	procd_append_param command --logfile "$LOG"
	procd_append_param command --logfile-maxbackups "$log_maxbackups"
	procd_append_param command --logfile-maxsize "$log_maxsize"
	# daed 需要 v2ray geo 数据目录；以前由 LuCI 包的 init 用 sed 往本文件里注入，
	# 那会改坏本 conffile 的出厂 hash（升级永远落成 daed.apk-new），此处直接内置。
	procd_set_param env DAE_LOCATION_ASSET=/usr/share/v2ray

	procd_set_param limits core="unlimited"
	procd_set_param limits nofile="1000000 1000000"
	procd_set_param respawn
	procd_set_param stderr 1

	procd_close_instance
}

stop_service() {
	# 不删日志：日志轮转交给 --logfile-maxbackups/--logfile-maxsize，
	# 在 stop/restart 时清空会让排障失去上下文（旧实现会 rm -f $LOG）。
	restore_resolv_conf
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}
