
config daed 'config'
	option enabled '0'
	option listen_addr '0.0.0.0:2023'
	option log_maxbackups '1'
	option log_maxsize '5'
	# 可选：把 /tmp/resolv.conf 临时替换成 WAN 上游 DNS（daed 运行期间）。
	# 默认关闭——netifd 写入的 /tmp/resolv.conf 通常已经是上游 DNS。
	option hijack_resolv '0'
	# 开机时先等 WAN 拨号完成再启动 daed（PPPoE 一般要 ~20 秒）。
	# 0 = 立刻启动，回到旧行为。
	option delay_start '1'
	# 等 WAN 的上限（秒）。超时后照常启动，避免 WAN 故障时永远起不来。
	option wan_timeout '60'
	# 定时更新 geoip.dat / geosite.dat（daed 只在启动时读取）。
	# 0 会移除 root crontab 里由本项目维护的那条任务。
	option geo_update '1'
	# 更新周期（五个字段：分 时 日 月 周）。默认每周一凌晨 3 点。
	option geo_update_cron '0 3 * * 1'
